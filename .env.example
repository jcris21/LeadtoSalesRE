APP_ENV=local
LOG_LEVEL=INFO

# Supabase project (Settings > Database > Connection string; use the pooled
# "Transaction" connection string, and the service_role key for backend access).
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-1-us-east-2.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=480

# Chatwoot (local docker-compose instance by default)
CHATWOOT_BASE_URL=http://localhost:3000
CHATWOOT_PLATFORM_API_KEY=

OUTBOX_POLL_INTERVAL_SECONDS=1.0
OUTBOX_BATCH_SIZE=50

OTEL_SERVICE_NAME=lead-to-sales-system
OTEL_EXPORTER_OTLP_ENDPOINT=
