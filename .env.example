APP_ENV=local
LOG_LEVEL=INFO

# Supabase project (Settings > Database > Connection string; use the pooled
# "Transaction" connection string, and the service_role key for backend access).
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-1-us-east-2.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=480

# Chatwoot (local docker-compose instance by default)
CHATWOOT_BASE_URL=http://localhost:3000
CHATWOOT_PLATFORM_API_KEY=

# wacrm (SoR for leads/pipeline). Local dev: mocks/wacrm_mock via docker-compose.
# Inside the compose network use http://wacrm-mock:8080
WACRM_BASE_URL=http://localhost:8080
CRM_SYNC_POLL_INTERVAL_SECONDS=30.0
CRM_STALENESS_THRESHOLD_SECONDS=60
PROFILE_COMPLETENESS_THRESHOLD=90.0

OUTBOX_POLL_INTERVAL_SECONDS=1.0
OUTBOX_BATCH_SIZE=50

OTEL_SERVICE_NAME=lead-to-sales-system
OTEL_EXPORTER_OTLP_ENDPOINT=

LANGSMITH_TRACING_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=lead-to-sales-system
LANGSMITH_ENDPOINT=
LANGSMITH_REDACT_PII=true

# US-307: Google Maps API key for Neighborhood Enrichment (Places Nearby
# Search). Optional — unset means no network calls, enrichment degrades to
# neighborhood=None for every property.
GOOGLE_MAPS_API_KEY=
